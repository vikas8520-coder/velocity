# Copy to .env.local or paste the same names on /app/settings

# --- Generation ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
POLLINATIONS_API_KEY=

# --- YouTube (Data API v3 key — ingest channels/shorts) ---
YOUTUBE_API_KEY=

# --- Meta: Instagram + Facebook (app id|secret for oEmbed; user token for Graph) ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- TikTok (Login Kit / Content Posting) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X (Twitter) ---
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- Pinterest / Reddit (optional ingest) ---
PINTEREST_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
